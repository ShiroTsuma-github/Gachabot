# Discord bot (never commit real values)
Discord__Enabled=true
Discord__BotToken=replace-with-bot-token
Discord__ActivityName=Schmidley
# Configure each server from Discord with: /gachabot-configure channel:#channel
# The former GuildId, ChannelId and AdministratorUserIds settings are optional
# one-time migration inputs for an existing single-server installation.

# Discord OAuth2 application used by the dashboard
Discord__OAuth__ClientId=replace-with-oauth-client-id
Discord__OAuth__ClientSecret=replace-with-oauth-client-secret

# Runtime
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8791
# Shared PostgreSQL storage.
DatabaseStorage__ConnectionString=Host=postgres-host;Port=5432;Database=gachabot;Username=gachabot;Password=replace-me
MediaArchive__RootPath=/app/data/media
MediaArchive__StagingPath=/app/data/media-staging
MediaArchive__MaximumDownloadSizeMegabytes=50
MediaArchive__MaximumStoredImageSizeMegabytes=9

# Garage / S3 media storage (never commit real values)
S3Media__Endpoint=http://garage-host:3900
S3Media__Region=garage
S3Media__AccessKey=replace-with-gachabot-media-key
S3Media__SecretKey=replace-with-gachabot-media-secret
S3Media__Bucket=gachabot-media
S3Media__Prefix=media
S3Media__ForcePathStyle=true
S3Media__GarbageCollectionGraceHours=24

# Sources for one-time seeding of private redeem-code banners
GameBanners__WutheringWavesSourceUrl=https://wutheringwaves.gg/wp-content/uploads/sites/8/2024/04/Wuthering-Waves-Key-Art-April-2024.jpg
GameBanners__NevernessToEvernessSourceUrl=https://cimg.kgl-systems.io/camion/files/10895/ogp.jpg?x=1280
