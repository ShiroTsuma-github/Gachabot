@inherits LayoutComponentBase

<a class="skip-link" href="#main-content">Skip to content</a>

<div class="app-shell">
    <aside class="signal-rail">
        <div class="brand-lockup">
            <span class="brand-mark" aria-hidden="true">S</span>
            <div>
                <strong>Schmidley</strong>
                <span>Discord event relay</span>
            </div>
        </div>

        <nav aria-label="Primary navigation">
            <NavLink href="/" Match="NavLinkMatch.All">Dashboard</NavLink>
            <NavLink href="/events">Events</NavLink>
            <NavLink href="/content" Match="NavLinkMatch.All">Content</NavLink>
            <NavLink href="/content/new">New post</NavLink>
            <NavLink href="/sources">Sources</NavLink>
            <NavLink href="/archive">Archive</NavLink>
            <NavLink href="/guilds">Guilds</NavLink>
            <NavLink href="/guide">Guide</NavLink>
        </nav>

        <div class="rail-footer">
            <span class="live-dot" aria-hidden="true"></span>
            <span>Monitor active</span>
        </div>
    </aside>

    <main>
        <header class="topbar">
            <form action="/auth/logout" method="post">
                <AntiforgeryToken />
                <button class="text-button" type="submit">Sign out</button>
            </form>
        </header>
        <div id="main-content" class="page-frame" tabindex="-1">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" role="alert">
    A UI error occurred.
    <a href="." class="reload">Reload</a>
    <button class="dismiss" type="button" aria-label="Dismiss">×</button>
</div>
