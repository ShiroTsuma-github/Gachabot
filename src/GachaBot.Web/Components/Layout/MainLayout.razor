@inherits LayoutComponentBase

<a class="skip-link" href="#main-content">Przejdź do treści</a>

<div class="app-shell">
    <aside class="signal-rail">
        <div class="brand-lockup">
            <span class="brand-mark" aria-hidden="true">GB</span>
            <div>
                <strong>Signal Desk</strong>
                <span>Gacha intelligence</span>
            </div>
        </div>

        <nav aria-label="Główna nawigacja">
            <NavLink href="/" Match="NavLinkMatch.All"><span>01</span>Pulpit</NavLink>
            <NavLink href="/events"><span>02</span>Wydarzenia</NavLink>
            <NavLink href="/content"><span>03</span>Treści</NavLink>
            <NavLink href="/content/new"><span>04</span>Nowy wpis</NavLink>
            <NavLink href="/sources"><span>05</span>Źródła</NavLink>
            <NavLink href="/archive"><span>06</span>Archiwum</NavLink>
            <NavLink href="/guilds"><span>07</span>Gildie</NavLink>
            <NavLink href="/guide"><span>08</span>Jak korzystać</NavLink>
        </nav>

        <div class="rail-footer">
            <span class="live-dot" aria-hidden="true"></span>
            <span>Monitor aktywny</span>
        </div>
    </aside>

    <main>
        <header class="topbar">
            <div>
                <span class="eyebrow">WUTHERING WAVES / NTE</span>
                <span class="topbar-note">Europe/Warsaw · zapis UTC</span>
            </div>
            <form action="/auth/logout" method="post">
                <AntiforgeryToken />
                <button class="text-button" type="submit">Wyloguj</button>
            </form>
        </header>
        <div id="main-content" class="page-frame" tabindex="-1">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" role="alert">
    Wystąpił błąd interfejsu.
    <a href="." class="reload">Odśwież</a>
    <button class="dismiss" type="button" aria-label="Zamknij">×</button>
</div>
