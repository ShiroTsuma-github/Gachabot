@page "/"
@inject IContentManagementStore ContentStore
@inject IOptions<SourcePollingOptions> PollingOptions

<PageTitle>Dashboard · Signal Desk</PageTitle>

<section class="page-heading">
    <div>
        <p class="eyebrow">OPERATIONS DESK / 01</p>
        <h1>Schmidley.</h1>
    </div>
    <a class="button button-primary" href="/content/new">+ Schedule post</a>
</section>

@if (_metrics is null)
{
    <p class="loading">Reading system state…</p>
}
else
{
    <section class="home-dashboard-grid">
        <aside class="home-schmidley-panel">
            <img src="images/schmidley.png" alt="Schmidley" />
        </aside>
        <div class="home-dashboard-content">
            <section class="metric-grid" aria-label="Content state">
                <a class="metric-card signal" href="/content?status=Active" aria-label="View active posts">
                    <span>Active</span>
                    <strong>@_metrics.Active</strong>
                    <small>on the radar</small>
                </a>
                <a class="metric-card" href="/events" aria-label="View scheduled events">
                    <span>Scheduled</span>
                    <strong>@_metrics.Scheduled</strong>
                    <small>Discord queue · events</small>
                </a>
                <a class="metric-card warning" href="/content?status=Draft" aria-label="View posts awaiting review">
                    <span>Review</span>
                    <strong>@_metrics.AwaitingReview</strong>
                    <small>community sources</small>
                </a>
                <a class="metric-card" href="/archive" aria-label="View archive">
                    <span>Archive</span>
                    <strong>@_metrics.Archived</strong>
                    <small>retained posts</small>
                </a>
            </section>

            <section class="status-board">
                <div>
                    <p class="eyebrow">LAST SIGNAL</p>
                    <h2>@FormatInstant(_metrics.LastSuccessfulImportUtc)</h2>
                </div>
                <div class="status-line">
                    <span class="live-dot" aria-hidden="true"></span>
                    <span>Polling every @PollingOptions.Value.IntervalMinutes min · transactional outbox delivery</span>
                </div>
            </section>
        </div>
    </section>
}

@code {
    private DashboardMetrics? _metrics;

    protected override async Task OnInitializedAsync()
    {
        _metrics = await ContentStore.GetMetricsAsync(CancellationToken.None);
    }

    private static string FormatInstant(DateTimeOffset? value) => value.HasValue
        ? value.Value.ToLocalTime().ToString("dd MMM yyyy · HH:mm", System.Globalization.CultureInfo.GetCultureInfo("en-US"))
        : "Awaiting first import";
}
