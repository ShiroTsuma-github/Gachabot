@page "/events"
@inject IContentManagementStore ContentStore
@inject TimeProvider Clock

<PageTitle>Wydarzenia · Signal Desk</PageTitle>

<section class="page-heading compact event-heading">
    <div>
        <p class="eyebrow">KALENDARZ / 02</p>
        <h1>Wydarzenia</h1>
        <p class="lede">Bieżące i nadchodzące aktywności w grze. Godziny są pokazywane w strefie lokalnej.</p>
    </div>
    <a class="button button-quiet" href="/sources">Odśwież źródła</a>
</section>

@if (_events is null)
{
    <p class="loading">Układam kalendarz…</p>
}
else
{
    <form class="event-filter" method="get" aria-label="Filtr wydarzeń">
        <label for="event-game">Gra</label>
        <select id="event-game" name="game" value="@Game">
            <option value="">Wszystkie gry</option>
            <option value="WutheringWaves">Wuthering Waves</option>
            <option value="NevernessToEverness">Neverness to Everness</option>
        </select>
        <div>
            <label for="event-source">Źródło</label>
            <select id="event-source" name="source" value="@Source">
                <option value="">Wszystkie źródła</option>
                @foreach (var sourceKey in SourceKeys)
                {
                    <option value="@sourceKey">@SourceLabel(sourceKey)</option>
                }
            </select>
        </div>
        <button class="button button-primary" type="submit">Pokaż</button>
        @if (!string.IsNullOrWhiteSpace(Game) || !string.IsNullOrWhiteSpace(Source))
        {
            <a class="button button-quiet" href="/events">Wyczyść</a>
        }
    </form>

    @if (VisibleEvents.Count == 0)
    {
        <section class="empty-state">
            <p class="eyebrow">KALENDARZ JEST PUSTY</p>
            <h2>Nie ma jeszcze aktywnych lub nadchodzących wydarzeń.</h2>
            <p>Uruchom import źródła, aby zasilić ten widok.</p>
        </section>
    }
    else
    {
        <section class="event-calendar" aria-label="Kalendarz wydarzeń do końca najdłuższego widocznego wydarzenia">
            <header>
                <div>
                    <span class="section-label">@CalendarStart.ToString("MMMM yyyy")</span>
                    <strong>Do @LatestEventEnd.ToString("dd.MM.yyyy")</strong>
                </div>
                <span class="calendar-legend"><i class="active"></i> trwa teraz <i class="upcoming"></i> nadchodzi</span>
            </header>
            <div class="calendar-weekdays" aria-hidden="true">
                @foreach (var name in WeekdayNames)
                {
                    <span>@name</span>
                }
            </div>
            <div class="calendar-grid">
                @foreach (var day in CalendarDays)
                {
                    var entries = EventsForDay(day);
                    <article class="calendar-day @(day == Today ? "today" : string.Empty)">
                        <time datetime="@day.ToString("yyyy-MM-dd")">@day.Day</time>
                        @foreach (var entry in entries)
                        {
                            <a class="calendar-event @EventState(entry)" href="/content/@entry.Id" title="@EventTooltip(entry)">
                                <span>@GameCode(entry.Game)</span>@CalendarLabel(entry)
                            </a>
                        }
                    </article>
                }
            </div>
        </section>

        <section class="event-agenda" aria-label="Lista wydarzeń">
            <header>
                <p class="eyebrow">AGENDA</p>
                <h2>@VisibleEvents.Count wydarzeń</h2>
            </header>
            <div>
                @foreach (var entry in VisibleEvents)
                {
                    <article class="event-row @EventState(entry)">
                        <span class="game-code">@GameCode(entry.Game)</span>
                        <div>
                            <a href="/content/@entry.Id">@entry.Title</a>
                            <p>@entry.StartAtUtc.ToLocalTime().ToString("dd.MM, HH:mm") → @entry.EndAtUtc.ToLocalTime().ToString("dd.MM, HH:mm")</p>
                        </div>
                        <span class="status-chip status-@entry.Status.ToString().ToLowerInvariant()">@EventStateLabel(entry)</span>
                    </article>
                }
            </div>
        </section>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "game")]
    public string? Game { get; set; }

    [SupplyParameterFromQuery(Name = "source")]
    public string? Source { get; set; }

    private IReadOnlyList<CalendarEvent>? _events;

    private IReadOnlyList<string> SourceKeys => (_events ?? [])
        .Select(item => item.SourceKey)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Order(StringComparer.OrdinalIgnoreCase)
        .ToArray();

    private DateOnly Today => DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);

    private DateOnly CalendarStart => Today.AddDays(-(((int)Today.DayOfWeek + 6) % 7));

    private DateOnly LatestEventEnd => VisibleEvents
        .Select(entry => DateOnly.FromDateTime(entry.EndAtUtc.ToLocalTime().DateTime))
        .Max();

    private DateOnly CalendarEnd => LatestEventEnd.AddDays(6 - (((int)LatestEventEnd.DayOfWeek + 6) % 7));

    private IReadOnlyList<DateOnly> CalendarDays => Enumerable.Range(
            0,
            CalendarEnd.DayNumber - CalendarStart.DayNumber + 1)
        .Select(CalendarStart.AddDays)
        .ToArray();

    private IReadOnlyList<CalendarEvent> VisibleEvents => (_events ?? [])
        .Where(item => string.IsNullOrWhiteSpace(Game) || string.Equals(item.Game.ToString(), Game, StringComparison.OrdinalIgnoreCase))
        .Where(item => string.IsNullOrWhiteSpace(Source) || string.Equals(item.SourceKey, Source, StringComparison.OrdinalIgnoreCase))
        .Where(item => item.EndAtUtc.ToLocalTime().Date >= CalendarStart.ToDateTime(TimeOnly.MinValue))
        .OrderBy(item => item.StartAtUtc)
        .ToArray();

    private static IReadOnlyList<string> WeekdayNames { get; } = ["Pon", "Wto", "Śro", "Czw", "Pią", "Sob", "Nie"];

    protected override async Task OnParametersSetAsync()
    {
        var events = (await ContentStore.ListAsync(null, null, CancellationToken.None))
            .Where(item => item.Kind == ContentKind.Event)
            .ToArray();
        var calendarEvents = new List<CalendarEvent>(events.Length);
        foreach (var item in events)
        {
            var details = await ContentStore.GetAsync(item.Id, CancellationToken.None);
            if (details?.ExpiresAtUtc is null || details.SourcePublishedAtUtc is null)
            {
                continue;
            }

            calendarEvents.Add(new CalendarEvent(
                item.Id,
                item.SourceKey,
                item.Game,
                item.Title,
                item.Status,
                details.SourcePublishedAtUtc.Value,
                details.ExpiresAtUtc.Value));
        }

        _events = calendarEvents;
    }

    private IReadOnlyList<CalendarEvent> EventsForDay(DateOnly day) => VisibleEvents
        .Where(entry =>
            (DateOnly.FromDateTime(entry.StartAtUtc.ToLocalTime().DateTime) < CalendarStart
                ? CalendarStart
                : DateOnly.FromDateTime(entry.StartAtUtc.ToLocalTime().DateTime)) == day)
        .ToArray();

    private string EventState(CalendarEvent entry) =>
        entry.StartAtUtc <= Clock.GetUtcNow() && entry.EndAtUtc > Clock.GetUtcNow() ? "active" : "upcoming";

    private string EventStateLabel(CalendarEvent entry) => EventState(entry) == "active" ? "Trwa" : "Nadchodzi";

    private static string EventTooltip(CalendarEvent entry) =>
        $"{entry.Title}: {entry.StartAtUtc.ToLocalTime():dd.MM HH:mm} – {entry.EndAtUtc.ToLocalTime():dd.MM HH:mm}";

    private static string CalendarLabel(CalendarEvent entry) =>
        $"{entry.Title} · do {entry.EndAtUtc.ToLocalTime():dd.MM}";

    private static string GameCode(GameKey game) => game == GameKey.WutheringWaves ? "WUWA" : "NTE";

    private static string SourceLabel(string sourceKey) => sourceKey switch
    {
        "wuwatracker-wuthering-waves-events" => "WuWa Tracker",
        "game8-neverness-to-everness-events" => "Game8 NTE Events",
        _ => sourceKey,
    };

    private sealed record CalendarEvent(
        Guid Id,
        string SourceKey,
        GameKey Game,
        string Title,
        ContentStatus Status,
        DateTimeOffset StartAtUtc,
        DateTimeOffset EndAtUtc);
}
