@page "/guilds/{GuildId:long}"
@inject IGuildDestinationStore Destinations
@inject IGuildPublicationHistoryStore PublicationHistory
@inject TimeProvider Clock

<PageTitle>Historia gildii · Signal Desk</PageTitle>

@if (_destination is null)
{
    <section class="empty-state">
        <p class="eyebrow">BRAK GILDII</p>
        <h1>Nie znaleziono tej konfiguracji.</h1>
        <a href="/guilds">Wróć do gildii →</a>
    </section>
}
else
{
    <section class="page-heading compact">
        <div>
            <p class="eyebrow">GILDIA / @_destination.GuildId</p>
            <h1>@DisplayGuildName(_destination)</h1>
            <p class="lede">
                Kanał docelowy: <a href="@ChannelUrl(_destination)" target="_blank" rel="noopener noreferrer">#@DisplayChannelName(_destination) ↗</a>
                · status: <strong>@(_destination.IsEnabled ? "aktywny" : "wstrzymany")</strong>.
            </p>
        </div>
        <a class="button button-quiet" href="/guilds">← Wszystkie gildie</a>
    </section>

    <section class="guild-detail-grid">
        <article class="guild-config-panel">
            <div class="section-label">OBSERWOWANE GRY</div>
            <div class="guild-topics large">
                @foreach (var game in _destination.Games.OrderBy(game => game))
                {
                    <span>@GameLabel(game)</span>
                }
            </div>
            <p>Zmiany kanału, stanu i obserwowanych gier wykonuje administrator przez <code>/gachabot-configure</code>, <code>/gachabot-enable</code> oraz <code>/gachabot-disable</code>.</p>
            <div class="event-notification-settings">
                <span>Start wydarzenia</span>
                <strong>@OffsetLabel(_destination.EventStartOffsetHours)</strong>
                <span>Przypomnienie o końcu</span>
                <strong>@OffsetLabel(_destination.EventEndOffsetHours)</strong>
            </div>
            <p>Zmienia to komenda <code>/gachabot-event-schedule</code> w Discordzie. Zakres obu wartości: 0–72 h; możesz podać np. <code>0.5</code>.</p>
        </article>

        <article class="guild-config-panel">
            <div class="section-label">KONFIGURACJA</div>
            <dl class="guild-facts">
                <div><dt>Identyfikator gildii</dt><dd>@_destination.GuildId</dd></div>
                <div><dt>Identyfikator kanału</dt><dd>@_destination.ChannelId</dd></div>
                <div><dt>Skonfigurował</dt><dd>@_destination.ConfiguredByUserId</dd></div>
                <div><dt>Ostatnia zmiana</dt><dd>@_destination.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy · HH:mm")</dd></div>
            </dl>
        </article>
    </section>

    <section class="guild-outbox" aria-labelledby="scheduled-publications-heading">
        <div class="outbox-heading">
            <div>
                <p class="eyebrow">OUTBOX / ZAPLANOWANE</p>
                <h2 id="scheduled-publications-heading">Co zostanie opublikowane</h2>
                <p>Pozycje oczekujące na wysłanie do kanału <strong>#@DisplayChannelName(_destination)</strong>.</p>
            </div>
            <span>@_pending.Count oczekujących</span>
        </div>
        @if (_pending.Count == 0)
        {
            <p class="empty-history">Nie ma obecnie zaplanowanych publikacji dla tej gildii.</p>
        }
        else
        {
            <div class="scheduled-publication-grid">
                @foreach (var item in _pending)
                {
                    <article class="scheduled-publication-card">
                        <header>
                            <span class="game-code">@GameCode(item.Game)</span>
                            <span class="queue-kind">@KindLabel(item.Kind)</span>
                            @if (item.Purpose != "Standard")
                            {
                                <span class="queue-kind">@PurposeLabel(item.Purpose)</span>
                            }
                            <span class="status-chip publication-state-@item.State.ToLowerInvariant()">@StateLabel(item.State)</span>
                        </header>
                        <a class="scheduled-publication-title" href="@($"/content/{item.ContentId}")">@item.Title</a>
                        <div class="scheduled-publication-time">
                            <span>@DueLabel(item)</span>
                            <time datetime="@item.DueAtUtc.ToString("O")">@item.DueAtUtc.ToLocalTime().ToString("dd.MM.yyyy · HH:mm")</time>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section class="publication-history">
        <div class="history-heading">
            <div>
                <p class="eyebrow">HISTORIA / OSTATNIE 50</p>
                <h2>Wysłane i rozliczone publikacje</h2>
            </div>
            <span>@_history.Count rekordów</span>
        </div>
        @if (_history.Count == 0)
        {
            <p class="empty-history">Ta gildia nie ma jeszcze historii wysyłek.</p>
        }
        else
        {
            <div class="data-table-wrap">
                <table class="data-table publication-table">
                    <thead>
                        <tr>
                            <th>Treść</th>
                            <th>Gra / typ</th>
                            <th>Stan</th>
                            <th>Aktualizacja</th>
                            <th>Próby</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _history)
                        {
                            <tr>
                                <td>
                                    <a class="content-title-link" href="@($"/content/{item.ContentId}")"><strong>@item.Title</strong></a>
                                    @if (!string.IsNullOrWhiteSpace(item.LastError))
                                    {
                                        <small class="publication-error">@item.LastError</small>
                                    }
                                </td>
                                <td><span class="game-code">@GameCode(item.Game)</span><small>@KindLabel(item.Kind) · @PurposeLabel(item.Purpose)</small></td>
                                <td><span class="status-chip publication-state-@item.State.ToLowerInvariant()">@StateLabel(item.State)</span></td>
                                <td><time>@item.UpdatedAtUtc.ToLocalTime().ToString("dd.MM · HH:mm")</time></td>
                                <td>@item.AttemptCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    [Parameter]
    public long GuildId { get; set; }

    private GuildDestination? _destination;
    private IReadOnlyList<GuildPublicationHistoryItem> _history = [];
    private IReadOnlyList<GuildPublicationHistoryItem> _pending = [];

    protected override async Task OnParametersSetAsync()
    {
        if (GuildId <= 0)
        {
            _destination = null;
            _history = [];
            _pending = [];
            return;
        }

        var guildId = checked((ulong)GuildId);
        _destination = (await Destinations.ListAsync(CancellationToken.None))
            .SingleOrDefault(destination => destination.GuildId == guildId);
        if (_destination is null)
        {
            _history = [];
            _pending = [];
            return;
        }

        _pending = await PublicationHistory.ListPendingForGuildAsync(guildId, 100, CancellationToken.None);
        _history = (await PublicationHistory.ListForGuildAsync(guildId, 100, CancellationToken.None))
            .Where(item => item.State is not "Pending" and not "Processing")
            .Take(50)
            .ToArray();
    }

    private static string DisplayGuildName(GuildDestination destination) =>
        string.IsNullOrWhiteSpace(destination.GuildName) ? $"Gildia {destination.GuildId}" : destination.GuildName;

    private static string DisplayChannelName(GuildDestination destination) =>
        string.IsNullOrWhiteSpace(destination.ChannelName) ? destination.ChannelId.ToString() : destination.ChannelName;

    private static string ChannelUrl(GuildDestination destination) =>
        $"https://discord.com/channels/{destination.GuildId}/{destination.ChannelId}";

    private static string GameLabel(GameKey game) => game == GameKey.WutheringWaves
        ? "Wuthering Waves"
        : "Neverness to Everness";

    private static string GameCode(GameKey game) => game == GameKey.WutheringWaves ? "WUWA" : "NTE";

    private string DueLabel(GuildPublicationHistoryItem item)
    {
        var remaining = item.DueAtUtc - Clock.GetUtcNow();
        if (remaining <= TimeSpan.Zero)
        {
            return item.State == "Processing" ? "trwa wysyłanie" : "gotowe do wysłania";
        }

        return remaining.TotalDays >= 1
            ? $"za {(int)Math.Ceiling(remaining.TotalDays)} dni"
            : remaining.TotalHours >= 1
                ? $"za {(int)Math.Ceiling(remaining.TotalHours)} h"
                : $"za {(int)Math.Ceiling(remaining.TotalMinutes)} min";
    }

    private static string KindLabel(string kind) => kind switch
    {
        "Event" => "Wydarzenie",
        "News" => "Aktualność",
        "Announcement" => "Ogłoszenie",
        "Update" => "Aktualizacja",
        "Maintenance" => "Utrzymanie",
        "RedeemCode" => "Kod",
        _ => kind,
    };

    private static string PurposeLabel(string purpose) => purpose switch
    {
        "EventStart" => "Start wydarzenia",
        "EventEndingReminder" => "Przypomnienie o końcu",
        _ => "Publikacja",
    };

    private static string OffsetLabel(double offsetHours) => offsetHours == 0
        ? "dokładnie w momencie"
        : $"{offsetHours.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)} h wcześniej";

    private static string StateLabel(string state) => state switch
    {
        "Pending" => "Oczekuje",
        "Processing" => "Wysyłanie",
        "Published" => "Wysłano",
        "Failed" => "Błąd",
        "Cancelled" => "Anulowano",
        _ => state,
    };
}
