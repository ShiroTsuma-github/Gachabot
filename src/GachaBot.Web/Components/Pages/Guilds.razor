@page "/guilds"
@inject IGuildDestinationStore Destinations

<PageTitle>Gildie · Signal Desk</PageTitle>

<section class="page-heading compact">
    <div>
        <p class="eyebrow">DYSTRYBUCJA / 06</p>
        <h1>Gildie</h1>
        <p class="lede">Kanały, które aktualnie odbierają sygnały. Każda konfiguracja pozostaje niezależna.</p>
    </div>
</section>

@if (_destinations is null)
{
    <p class="loading">Odczytuję konfiguracje gildii…</p>
}
else if (_destinations.Count == 0)
{
    <section class="empty-state">
        <p class="eyebrow">BRAK KONFIGURACJI</p>
        <h2>Bot nie został jeszcze skonfigurowany na żadnym serwerze.</h2>
        <p>Administrator serwera może uruchomić <code>/gachabot-configure</code> i wybrać kanał publikacji.</p>
    </section>
}
else
{
    <section class="guild-grid" aria-label="Skonfigurowane gildie">
        @foreach (var destination in _destinations)
        {
            <article class="guild-card @(destination.IsEnabled ? "" : "paused")">
                <header>
                    <div>
                        <p class="eyebrow">GILDIA @destination.GuildId</p>
                        <h2>@DisplayGuildName(destination)</h2>
                    </div>
                    <span class="guild-state">@(destination.IsEnabled ? "AKTYWNA" : "WSTRZYMANA")</span>
                </header>
                <dl>
                    <div>
                        <dt>Kanał</dt>
                        <dd><a href="@ChannelUrl(destination)" target="_blank" rel="noopener noreferrer">#@DisplayChannelName(destination) ↗</a></dd>
                    </div>
                    <div>
                        <dt>Ostatnia zmiana</dt>
                        <dd>@destination.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy · HH:mm")</dd>
                    </div>
                </dl>
                <div class="guild-topics" aria-label="Obserwowane gry">
                    @foreach (var game in destination.Games.OrderBy(game => game))
                    {
                        <span>@GameLabel(game)</span>
                    }
                </div>
                <dl class="guild-event-timing">
                    <div><dt>Start wydarzenia</dt><dd>@OffsetLabel(destination.EventStartOffsetHours)</dd></div>
                    <div><dt>Przypomnienie o końcu</dt><dd>@OffsetLabel(destination.EventEndOffsetHours)</dd></div>
                </dl>
                <a class="guild-history-link" href="@($"/guilds/{destination.GuildId}")">Zobacz kolejkę i historię →</a>
            </article>
        }
    </section>
}

@code {
    private IReadOnlyList<GuildDestination>? _destinations;

    protected override async Task OnInitializedAsync() =>
        _destinations = await Destinations.ListAsync(CancellationToken.None);

    private static string DisplayGuildName(GuildDestination destination) =>
        string.IsNullOrWhiteSpace(destination.GuildName) ? $"Gildia {destination.GuildId}" : destination.GuildName;

    private static string DisplayChannelName(GuildDestination destination) =>
        string.IsNullOrWhiteSpace(destination.ChannelName) ? destination.ChannelId.ToString() : destination.ChannelName;

    private static string ChannelUrl(GuildDestination destination) =>
        $"https://discord.com/channels/{destination.GuildId}/{destination.ChannelId}";

    private static string GameLabel(GameKey game) => game == GameKey.WutheringWaves
        ? "Wuthering Waves"
        : "Neverness to Everness";

    private static string OffsetLabel(double offsetHours) => offsetHours == 0
        ? "w momencie"
        : $"{offsetHours.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)} h wcześniej";
}
